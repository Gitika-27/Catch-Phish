{
  "manifest_version": 3,
  "name": "CatchPhish Navigation Guard",
  "version": "1.0.0",
  "description": "Explainable navigation protection for suspicious and lookalike domains.",
  "permissions": [
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://catchphish-cef6.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CatchPhish Navigation Guard"
  }
}
